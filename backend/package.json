{
  "name": "poverka-bot-max-backend",
  "version": "2.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:photo-worker": "tsx watch src/photo-worker.ts",
    "dev:payment-worker": "tsx watch src/payment-worker.ts",
    "dev:report-worker": "tsx watch src/report-worker.ts",
    "dev:mail-worker": "tsx watch src/mail-worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:photo-worker": "node dist/photo-worker.js",
    "start:payment-worker": "node dist/payment-worker.js",
    "start:report-worker": "node dist/report-worker.js",
    "start:mail-worker": "node dist/mail-worker.js",
    "reports:generate": "tsx src/report-worker.ts generate-report",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^4.3.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.7",
    "pg": "^8.16.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^7.5.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^7.0.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
