generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SubmissionStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
}

enum SubmissionSource {
  MINIAPP
  BOT
  ADMIN
}

enum WaterType {
  HVS
  GVS
}

enum AuditEntityType {
  USER
  ORGANIZATION
  SUBMISSION
  AUTH_SESSION
  FILE
  SYSTEM
}

enum GeneratedReportStatus {
  PENDING
  SUCCESS
  ERROR
}

enum ReportRunStatus {
  SUCCESS
  FAILED
}

enum MailRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ReportRecipientType {
  ADMIN
  ORGANIZATION
}

enum ReportEmailDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Organization {
  id                BigInt  @id @default(autoincrement()) @map("org_id")
  balance           BigInt  @default(0)
  email             String? @unique @map("org_email")
  name              String  @map("org_name")
  balanceStartOfDay BigInt? @map("balance_start_of_day")
  userTarif         BigInt  @default(0) @map("user_tarif")

  users               User[]
  submissions         MeterSubmission[]
  billingEvents       SubmissionBillingEvent[]
  topups              OrganizationTopup[]
  balanceTransactions OrganizationBalanceTransaction[]
  generatedReports    GeneratedReport[]
  reportEmailDeliveries ReportEmailDelivery[]

  @@map("organizations")
}

model User {
  id             BigInt   @id @default(autoincrement()) @map("user_id")
  organizationId BigInt?  @map("org_id")
  role           UserRole @default(USER)
  userTarif      Float?   @map("user_tarif") @db.DoublePrecision
  city           String?  @map("user_city")
  fullName       String   @map("user_fullname")
  phone          String?  @map("user_phone")
  orgName        String?  @map("org_name")
  orgEmail       String?  @map("org_email")

  organization               Organization?                    @relation(fields: [organizationId], references: [id])
  submissions                MeterSubmission[]
  statusHistory              SubmissionStatusHistory[]        @relation("StatusChangedBy")
  refreshTokens              AuthRefreshToken[]
  createdAuditLogs           AuditLog[]                       @relation("CreatedByUser")
  files                      FileEntity[]
  billingEvents              SubmissionBillingEvent[]
  topups                     OrganizationTopup[]
  botState                   BotUserState?
  balanceTransactionsCreated OrganizationBalanceTransaction[] @relation("BalanceTransactionCreatedBy")

  @@index([organizationId])
  @@map("users")
}

model MeterSubmission {
  id              String           @id @default(cuid())
  userId          BigInt           @map("user_id")
  organizationId  BigInt           @map("organization_id")
  meterNumber     String           @map("meter_number")
  currentValue    Decimal          @map("current_value") @db.Decimal(14, 3)
  address         String?          @map("address")
  phone           String?          @map("phone")
  waterType       WaterType?       @map("water_type")
  equipmentTypeId Int?             @map("equipment_type_id")
  customEquipmentTypeName String?  @map("custom_equipment_type_name")
  productionYear  Int?             @map("production_year")
  awaitingPhoto   Boolean          @default(false) @map("awaiting_photo")
  status          SubmissionStatus
  source          SubmissionSource @default(MINIAPP)
  draftCreatedAt  DateTime         @default(now()) @map("draft_created_at") @db.Timestamptz(3)
  confirmedAt     DateTime?        @map("confirmed_at") @db.Timestamptz(3)
  rejectedAt      DateTime?        @map("rejected_at") @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User                      @relation(fields: [userId], references: [id])
  organization  Organization              @relation(fields: [organizationId], references: [id])
  equipmentType EquipmentType?            @relation(fields: [equipmentTypeId], references: [id])
  statusHistory SubmissionStatusHistory[]
  files         FileEntity[]
  billingEvents SubmissionBillingEvent[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([equipmentTypeId])
  @@index([status, createdAt(sort: Desc)])
  @@map("meter_submissions")
}

model SubmissionStatusHistory {
  id              String            @id @default(cuid())
  submissionId    String            @map("submission_id")
  oldStatus       SubmissionStatus? @map("old_status")
  newStatus       SubmissionStatus  @map("new_status")
  changedByUserId BigInt?           @map("changed_by_user_id")
  reason          String?
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  submission    MeterSubmission @relation(fields: [submissionId], references: [id])
  changedByUser User?           @relation("StatusChangedBy", fields: [changedByUserId], references: [id])

  @@index([submissionId, createdAt(sort: Desc)])
  @@map("submission_status_history")
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId BigInt?         @map("actor_user_id")
  action      String
  entityType  AuditEntityType @map("entity_type")
  entityId    String?         @map("entity_id")
  meta        Json?
  ip          String?
  userAgent   String?         @map("user_agent")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  actorUser User? @relation("CreatedByUser", fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model AuthRefreshToken {
  id              String    @id @default(cuid())
  userId          BigInt    @map("user_id")
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByToken String?   @map("replaced_by_token")
  createdByIp     String?   @map("created_by_ip")
  userAgent       String?   @map("user_agent")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, expiresAt])
  @@map("auth_refresh_tokens")
}

model InitDataReplay {
  id        String   @id @default(cuid())
  replayKey String   @unique @map("replay_key")
  maxUserId String   @map("max_user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("init_data_replays")
}

model FileEntity {
  id              String    @id @default(cuid())
  ownerUserId     BigInt?   @map("owner_user_id")
  submissionId    String?   @map("submission_id")
  storageKey      String    @unique @map("storage_key")
  compressedPath  String?   @map("compressed_path")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  processingError String?   @map("processing_error")
  originalName    String    @map("original_name")
  mimeType        String    @map("mime_type")
  sizeBytes       Int       @map("size_bytes")
  publicUrl       String    @map("public_url")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  ownerUser  User?            @relation(fields: [ownerUserId], references: [id])
  submission MeterSubmission? @relation(fields: [submissionId], references: [id])

  @@index([ownerUserId])
  @@index([submissionId])
  @@map("files")
}

model SubmissionBillingEvent {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  organizationId BigInt   @map("organization_id")
  submissionId   String   @unique @map("submission_id")
  amountRubles   BigInt   @default(0) @map("amount_rubles")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User            @relation(fields: [userId], references: [id])
  organization Organization    @relation(fields: [organizationId], references: [id])
  submission   MeterSubmission @relation(fields: [submissionId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("submission_billing_events")
}

model EquipmentType {
  id   Int    @id
  name String @unique

  submissions MeterSubmission[]

  @@map("equipment_types")
}

model OrganizationTopup {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         BigInt    @map("organization_id")
  userId                 BigInt    @map("user_id")
  status                 String
  packagesCount          Int       @map("packages_count")
  tariffPerPackageRubles BigInt    @map("tariff_per_package_rubles")
  amountRubles           BigInt    @map("amount_rubles")
  currency               String    @default("RUB")
  provider               String    @default("yookassa")
  providerConfirmationUrl String?   @map("provider_confirmation_url")
  providerPaymentId      String?   @map("provider_payment_id")
  providerStatus         String?   @map("provider_status")
  providerIdempotenceKey String?   @map("provider_idempotence_key")
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(3)
  paidAt                 DateTime? @map("paid_at") @db.Timestamptz(3)
  canceledAt             DateTime? @map("canceled_at") @db.Timestamptz(3)
  cancelReasonCode       String?   @map("cancel_reason_code")
  cancelReasonText       String?   @map("cancel_reason_text")
  lastProviderSyncAt     DateTime? @map("last_provider_sync_at") @db.Timestamptz(3)
  nextPollAt             DateTime? @map("next_poll_at") @db.Timestamptz(3)
  pollAttempts           Int       @default(0) @map("poll_attempts")
  errorMessage           String?   @map("error_message")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization                      @relation(fields: [organizationId], references: [id])
  user         User                              @relation(fields: [userId], references: [id])
  attempts     OrganizationTopupPaymentAttempt[]

  @@index([status, nextPollAt])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@map("organization_topups")
}

model OrganizationBalanceTransaction {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      BigInt   @map("organization_id")
  direction           String
  amountRubles        BigInt   @map("amount_rubles")
  balanceBeforeRubles BigInt   @map("balance_before_rubles")
  balanceAfterRubles  BigInt   @map("balance_after_rubles")
  sourceType          String   @map("source_type")
  sourceId            String   @map("source_id")
  createdByUserId     BigInt?  @map("created_by_user_id")
  comment             String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization @relation(fields: [organizationId], references: [id])
  createdByUser User?        @relation("BalanceTransactionCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([sourceType, sourceId, direction])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("organization_balance_transactions")
}

model OrganizationTopupPaymentAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  topupId            String    @map("topup_id") @db.Uuid
  providerInvoiceId  String?   @map("provider_invoice_id")
  providerPaymentId  String    @unique @map("provider_payment_id")
  status             String
  amountRubles       BigInt    @map("amount_rubles")
  currency           String    @default("RUB")
  paid               Boolean   @default(false)
  cancellationParty  String?   @map("cancellation_party")
  cancellationReason String?   @map("cancellation_reason")
  rawPayload         Json?     @map("raw_payload")
  firstSeenAt        DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  paidAt             DateTime? @map("paid_at") @db.Timestamptz(3)
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  topup OrganizationTopup @relation(fields: [topupId], references: [id])

  @@index([topupId, createdAt(sort: Desc)])
  @@map("organization_topup_payment_attempts")
}

model YookassaWebhookLog {
  id               BigInt    @id @default(autoincrement())
  eventType        String    @map("event_type")
  providerObjectId String    @map("provider_object_id")
  topupId          String?   @map("topup_id") @db.Uuid
  remoteIp         String?   @map("remote_ip") @db.Inet
  isTrustedIp      Boolean   @default(false) @map("is_trusted_ip")
  headers          Json?
  payload          Json
  payloadSha256    String    @unique @map("payload_sha256")
  processingStatus String    @default("received") @map("processing_status")
  processingError  String?   @map("processing_error")
  receivedAt       DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(3)

  @@index([providerObjectId])
  @@map("yookassa_webhook_log")
}

model BotUserState {
  userId    BigInt   @id @map("user_id")
  state     String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@map("bot_user_states")
}

model GeneratedReport {
  id         BigInt                @id @default(autoincrement())
  reportCode String                @map("report_code")
  reportDate DateTime              @map("report_date") @db.Date
  organizationId BigInt?           @map("organization_id")
  fileName   String                @map("file_name")
  filePath   String                @map("file_path")
  publicUrl  String                @map("public_url")
  status     GeneratedReportStatus @default(PENDING)
  rowsCount  Int                   @default(0) @map("rows_count")
  errorText  String?               @map("error_text")
  startedAt  DateTime?             @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?             @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization?       @relation(fields: [organizationId], references: [id])

  @@unique([reportCode, reportDate, organizationId])
  @@index([organizationId, reportDate(sort: Desc)])
  @@index([status, reportDate(sort: Desc)])
  @@map("generated_reports")
}

model ReportRun {
  id                   BigInt        @id @default(autoincrement())
  reportDate           DateTime      @map("report_date") @db.Date
  trigger              String
  status               ReportRunStatus
  totalReports         Int           @default(0) @map("total_reports")
  successfulReports    Int           @default(0) @map("successful_reports")
  failedReports        Int           @default(0) @map("failed_reports")
  startedAt            DateTime?     @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?     @map("finished_at") @db.Timestamptz(3)
  errorText            String?       @map("error_text")
  autoMailRunEnqueued  Boolean       @default(false) @map("auto_mail_run_enqueued")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([reportDate])
  @@index([status, reportDate(sort: Desc)])
  @@map("report_runs")
}

model MailRun {
  id              BigInt      @id @default(autoincrement())
  reportDate      DateTime    @map("report_date") @db.Date
  trigger         String
  force           Boolean     @default(false)
  requestedBy     String?     @map("requested_by")
  status          MailRunStatus @default(PENDING)
  totalDeliveries Int         @default(0) @map("total_deliveries")
  sentCount       Int         @default(0) @map("sent_count")
  failedCount     Int         @default(0) @map("failed_count")
  startedAt       DateTime?   @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime?   @map("finished_at") @db.Timestamptz(3)
  errorText       String?     @map("error_text")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  attempts ReportEmailDeliveryAttempt[]

  @@index([status, createdAt(sort: Asc)])
  @@index([reportDate, createdAt(sort: Desc)])
  @@map("mail_runs")
}

model ReportEmailDelivery {
  id             BigInt                    @id @default(autoincrement())
  reportDate     DateTime                  @map("report_date") @db.Date
  reportType     String                    @map("report_type")
  fileName       String                    @map("file_name")
  filePath       String                    @map("file_path")
  orgId          BigInt?                   @map("org_id")
  recipientEmail String?                   @map("recipient_email")
  recipientKey   String                    @map("recipient_key")
  recipientType  ReportRecipientType       @map("recipient_type")
  status         ReportEmailDeliveryStatus @default(PENDING)
  attemptsCount  Int                       @default(0) @map("attempts_count")
  lastError      String?                   @map("last_error")
  sentAt         DateTime?                 @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization?               @relation(fields: [orgId], references: [id])
  attempts     ReportEmailDeliveryAttempt[]

  @@unique([reportDate, reportType, fileName, recipientKey])
  @@index([reportDate, status, recipientType])
  @@index([orgId, reportDate(sort: Desc)])
  @@map("report_email_deliveries")
}

model ReportEmailDeliveryAttempt {
  id         BigInt                    @id @default(autoincrement())
  deliveryId BigInt                    @map("delivery_id")
  mailRunId  BigInt?                   @map("mail_run_id")
  attemptNo  Int                       @map("attempt_no")
  forced     Boolean                   @default(false)
  status     ReportEmailDeliveryStatus
  errorText  String?                   @map("error_text")
  createdAt  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)

  delivery ReportEmailDelivery @relation(fields: [deliveryId], references: [id])
  mailRun  MailRun?            @relation(fields: [mailRunId], references: [id])

  @@index([deliveryId, createdAt(sort: Desc)])
  @@index([mailRunId, createdAt(sort: Desc)])
  @@map("report_email_delivery_attempts")
}
