POSTGRES_DB=maxapp
POSTGRES_USER=maxuser
POSTGRES_PASSWORD=change_me
APP_TIMEZONE=Europe/Moscow
# Used by backend submission window checks (00:01-21:59 MSK)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://maxuser:change_me@db:5432/maxapp
BACKEND_PUBLIC_URL=https://api.example.com
MINIAPP_PUBLIC_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
ADMIN_PANEL_PUBLIC_URL=https://admin.poverka-bot.ru


ADMIN_AUTH_LOGIN=admin
ADMIN_AUTH_PASSWORD=change_me_to_strong_password
ADMIN_SESSION_SECRET=change_me_to_long_random_secret
ADMIN_SESSION_DURATION_DAYS=30

JWT_ACCESS_SECRET=replace_me_with_very_long_secret_32_chars_min
JWT_ACCESS_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=max_refresh_token
AUTH_COOKIE_SECURE=true

MAX_BOT_TOKEN=replace_me
MAX_WEBHOOK_SECRET=replace_me
MAX_INITDATA_TTL_SECONDS=300
INITDATA_REPLAY_TTL_SECONDS=600

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=20

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=https://api.example.com/static
PHOTO_WORKER_POLL_INTERVAL_MS=5000
PHOTO_ORIGINAL_DIR=./storage/photos/original
PHOTO_COMPRESSED_DIR=./storage/photos/compressed
PUBLIC_FILES_BASE_URL=https://api.example.com/uploads
REPORTS_STORAGE_DIR=/app/storage/reports
REPORTS_PUBLIC_BASE_URL=https://api.example.com/uploads/reports
REPORTS_CRON=5 22 * * *
REPORTS_TZ=Europe/Moscow
REPORTS_HTTP_PORT=3010
REPORT_WORKER_INTERNAL_BASE_URL=http://report-worker:3010
REPORTS_LOCK_ID=7342052205
FILE_RETENTION_DAYS=30
FILE_CLEANUP_CRON=0 1 * * *
FILE_CLEANUP_TZ=Europe/Moscow
FILE_CLEANUP_BATCH_SIZE=200
INTERNAL_API_TOKEN=replace_me_internal_token
REPORTS_BASE_DIR=/app/storage/reports

SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM=reports@example.com
REPORT_ADMIN_EMAILS=admin1@example.com,admin2@example.com
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=5000
MAIL_WORKER_POLL_INTERVAL_MS=5000
MAIL_API_TOKEN=replace_me_mail_api_token

VITE_API_BASE_URL=
VITE_DEFAULT_BACKEND_PUBLIC_URL=https://api.example.com

############################################################
# YOOKASSA / PAYMENTS (fill this block carefully)
############################################################
# YooKassa API endpoint (do not remove /v3):
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3

# REQUIRED: from YooKassa shop settings
YOOKASSA_SHOP_ID=replace_me
YOOKASSA_SECRET_KEY=replace_me

YOOKASSA_CURRENCY=RUB
# VAT code for receipt item (1 = without VAT)
YOOKASSA_RECEIPT_VAT_CODE=1
YOOKASSA_RETURN_URL=https://app.example.com/payment-return
YOOKASSA_WEBHOOK_URL=https://api.example.com/api/payments/yookassa/webhook

# Request timeout to YooKassa API (ms)
YOOKASSA_HTTP_TIMEOUT_MS=10000

YOOKASSA_WEBHOOK_ALLOWED_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32

# Topup business rules
PAYMENT_MIN_PACKAGES_PER_TOPUP=1
PAYMENT_MAX_PACKAGES_PER_TOPUP=1000
TOPUP_LINK_TTL_SECONDS=180

# Worker polling/backoff
PAYMENT_POLL_INTERVAL_SECONDS=10
PAYMENT_POLL_BATCH_SIZE=50
PAYMENT_POLL_BACKOFF_BASE_SECONDS=5
PAYMENT_POLL_BACKOFF_MAX_SECONDS=120
